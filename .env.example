NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity_service
SESSION_COOKIE_NAME=identity_service_session
LOG_LEVEL=info

# Cross-site deployment (optional). Defaults below preserve same-site / BFF
# behavior: CORS disabled and a SameSite=lax cookie.
#
# CORS allow-list for the browser surface. Unset/empty keeps CORS disabled.
# Use `*` to reflect any origin, or a comma-separated list of explicit origins.
# CORS_ORIGIN=https://other-gpt.example.com,https://cost-console.example.com
# Allow credentials (cookies) on CORS responses. Only relevant with CORS_ORIGIN.
CORS_CREDENTIALS=true
# Session cookie SameSite: lax | strict | none. `none` is required for genuine
# cross-site use and forces the cookie to be `secure` (HTTPS only).
COOKIE_SAMESITE=lax
# Override the `secure` cookie flag (true|false). Unset follows
# NODE_ENV === 'production'; SameSite=none always forces it on.
# COOKIE_SECURE=true
