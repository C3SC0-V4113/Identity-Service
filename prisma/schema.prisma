generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ProjectStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ProjectMembershipAuditAction {
  CREATED
  ROLES_REPLACED
  SUSPENDED
  REACTIVATED
  REVOKED
  READMITTED
}

enum ServicePrincipalStatus {
  ACTIVE
  DISABLED
}

enum AdminOperationStatus {
  COMPLETED
  PENDING_APPROVAL
  DENIED
  FAILED
}

enum AdminActionEventType {
  REQUESTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  DENIED
  FAILED
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id                          String                      @id @default(cuid())
  email                       String                      @db.Text
  emailNormalized             String                      @unique(map: "users_email_normalized_key") @map("email_normalized") @db.Text
  displayName                 String?                     @map("display_name") @db.Text
  status                      UserStatus                  @default(ACTIVE)
  bannedAt                    DateTime?                   @map("banned_at") @db.Timestamptz(3)
  createdAt                   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  localCredential             LocalCredential?
  sessions                    Session[]
  memberships                 ProjectMembership[]
  membershipAuditLogsAsActor  ProjectMembershipAuditLog[] @relation("project_membership_audit_actor")
  membershipAuditLogsAsTarget ProjectMembershipAuditLog[] @relation("project_membership_audit_target")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model LocalCredential {
  id                String   @id @default(cuid())
  userId            String   @unique(map: "local_credentials_user_id_key") @map("user_id")
  passwordHash      String   @map("password_hash") @db.Text
  passwordUpdatedAt DateTime @default(now()) @map("password_updated_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
}

model Session {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  projectId     String?       @map("project_id")
  secretHash    String        @unique(map: "sessions_secret_hash_key") @map("secret_hash") @db.Text
  status        SessionStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime?     @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?       @map("revoked_reason") @db.Text
  ipAddress     String?       @map("ip_address") @db.Text
  userAgent     String?       @map("user_agent") @db.Text
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([projectId], map: "sessions_project_id_idx")
  @@index([projectId, status], map: "sessions_project_id_status_idx")
  @@index([status], map: "sessions_status_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model Project {
  id                     String                         @id @default(cuid())
  slug                   String                         @unique(map: "projects_slug_key") @db.Text
  name                   String                         @db.Text
  status                 ProjectStatus                  @default(ACTIVE)
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles                  ProjectRole[]
  memberships            ProjectMembership[]
  sessions               Session[]
  membershipAuditLogs    ProjectMembershipAuditLog[]
  servicePrincipalScopes ServicePrincipalProjectScope[]

  @@map("projects")
}

model ProjectRole {
  id              String                  @id @default(cuid())
  projectId       String                  @map("project_id")
  code            String                  @db.Text
  name            String                  @db.Text
  description     String?                 @db.Text
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membershipRoles ProjectMembershipRole[]

  @@unique([projectId, code], map: "project_roles_project_id_code_key")
  @@index([projectId], map: "project_roles_project_id_idx")
  @@map("project_roles")
}

model ProjectMembership {
  id              String                      @id @default(cuid())
  projectId       String                      @map("project_id")
  userId          String                      @map("user_id")
  status          MembershipStatus            @default(ACTIVE)
  metadata        Json?
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  project         Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipRoles ProjectMembershipRole[]
  auditLogs       ProjectMembershipAuditLog[]

  @@unique([projectId, userId], map: "project_memberships_project_id_user_id_key")
  @@index([projectId], map: "project_memberships_project_id_idx")
  @@index([userId], map: "project_memberships_user_id_idx")
  @@map("project_memberships")
}

model ProjectMembershipRole {
  membershipId String            @map("membership_id")
  roleId       String            @map("role_id")
  membership   ProjectMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         ProjectRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId], map: "project_membership_roles_role_id_idx")
  @@map("project_membership_roles")
}

model ProjectMembershipAuditLog {
  id            String                       @id @default(cuid())
  action        ProjectMembershipAuditAction
  projectId     String                       @map("project_id")
  membershipId  String                       @map("membership_id")
  actorUserId   String                       @map("actor_user_id")
  targetUserId  String                       @map("target_user_id")
  fromStatus    MembershipStatus?            @map("from_status")
  toStatus      MembershipStatus?            @map("to_status")
  fromRoleCodes String[]                     @map("from_role_codes")
  toRoleCodes   String[]                     @map("to_role_codes")
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  project       Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership    ProjectMembership            @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  actorUser     User                         @relation("project_membership_audit_actor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUser    User                         @relation("project_membership_audit_target", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "project_membership_audit_logs_project_id_idx")
  @@index([membershipId], map: "project_membership_audit_logs_membership_id_idx")
  @@index([actorUserId], map: "project_membership_audit_logs_actor_user_id_idx")
  @@index([targetUserId], map: "project_membership_audit_logs_target_user_id_idx")
  @@index([action], map: "project_membership_audit_logs_action_idx")
  @@index([createdAt], map: "project_membership_audit_logs_created_at_idx")
  @@map("project_membership_audit_logs")
}

model ServicePrincipal {
  id            String                         @id @default(cuid())
  slug          String                         @unique(map: "service_principals_slug_key") @db.Text
  name          String                         @db.Text
  description   String?                        @db.Text
  status        ServicePrincipalStatus         @default(ACTIVE)
  secretHash    String                         @unique(map: "service_principals_secret_hash_key") @map("secret_hash") @db.Text
  allProjects   Boolean                        @default(false) @map("all_projects")
  lastUsedAt    DateTime?                      @map("last_used_at") @db.Timestamptz(3)
  createdAt     DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  projectScopes ServicePrincipalProjectScope[]
  operations    AdminOperation[]

  @@index([status], map: "service_principals_status_idx")
  @@map("service_principals")
}

model ServicePrincipalProjectScope {
  servicePrincipalId String           @map("service_principal_id")
  projectId          String           @map("project_id")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  servicePrincipal   ServicePrincipal @relation(fields: [servicePrincipalId], references: [id], onDelete: Cascade)
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([servicePrincipalId, projectId])
  @@index([projectId], map: "service_principal_project_scopes_project_id_idx")
  @@map("service_principal_project_scopes")
}

model AdminOperation {
  id                 String               @id @default(cuid())
  operationName      String               @map("operation_name") @db.Text
  status             AdminOperationStatus
  servicePrincipalId String?              @map("service_principal_id")
  operatorUserId     String?              @map("operator_user_id") @db.Text
  sourceChannel      String?              @map("source_channel") @db.Text
  idempotencyKey     String               @map("idempotency_key") @db.Text
  correlationId      String?              @map("correlation_id") @db.Text
  reason             String?              @db.Text
  ticketRef          String?              @map("ticket_ref") @db.Text
  targetProjectId    String?              @map("target_project_id") @db.Text
  targetUserId       String?              @map("target_user_id") @db.Text
  targetSessionId    String?              @map("target_session_id") @db.Text
  pendingPayloadJson Json?                @map("pending_payload_json")
  policyVersion      String?              @map("policy_version") @db.Text
  errorCode          String?              @map("error_code") @db.Text
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  servicePrincipal   ServicePrincipal?    @relation(fields: [servicePrincipalId], references: [id], onDelete: SetNull)
  auditEvents        AdminActionAudit[]
  approval           AdminApproval?

  @@unique([servicePrincipalId, idempotencyKey], map: "admin_operations_principal_idempotency_key")
  @@index([status], map: "admin_operations_status_idx")
  @@index([correlationId], map: "admin_operations_correlation_id_idx")
  @@index([createdAt], map: "admin_operations_created_at_idx")
  @@map("admin_operations")
}

model AdminActionAudit {
  id                  String               @id @default(cuid())
  operationId         String               @map("operation_id")
  eventType           AdminActionEventType @map("event_type")
  occurredAt          DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId         String?              @map("actor_user_id") @db.Text
  detail              String?              @db.Text
  requestSnapshotJson Json?                @map("request_snapshot_json")
  resultSnapshotJson  Json?                @map("result_snapshot_json")
  errorCode           String?              @map("error_code") @db.Text
  operation           AdminOperation       @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId], map: "admin_action_audits_operation_id_idx")
  @@index([eventType], map: "admin_action_audits_event_type_idx")
  @@index([occurredAt], map: "admin_action_audits_occurred_at_idx")
  @@map("admin_action_audits")
}

model AdminApproval {
  id                    String              @id @default(cuid())
  operationId           String              @unique(map: "admin_approvals_operation_id_key") @map("operation_id")
  status                AdminApprovalStatus @default(PENDING)
  requestedByUserId     String?             @map("requested_by_user_id") @db.Text
  requiredApprovalLevel String              @map("required_approval_level") @db.Text
  approvedByUserId      String?             @map("approved_by_user_id") @db.Text
  requestedAt           DateTime            @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedAt             DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionReason        String?             @map("decision_reason") @db.Text
  expiresAt             DateTime            @map("expires_at") @db.Timestamptz(3)
  operation             AdminOperation      @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([status], map: "admin_approvals_status_idx")
  @@index([expiresAt], map: "admin_approvals_expires_at_idx")
  @@map("admin_approvals")
}
